{
  "name": "image-canvas",
  "private": true,
  "license": "MIT",
  "author": "Momakoding (Saša)",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch --import tsx server/index.ts\" \"vite\"",
    "dev:server": "node --watch --import tsx server/index.ts",
    "dev:web": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "skin:install": "node scripts/skin.mjs install",
    "skin:update": "node scripts/skin.mjs update",
    "skin:remove": "node scripts/skin.mjs remove"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.45"
  }
}
